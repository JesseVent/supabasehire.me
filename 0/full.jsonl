{"parentUuid":"18459e0d-9899-45ca-b710-a14bc1a8392b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/jvent/Dev/supabase/supabase-devtool/src/lib/supabase-mcp-client.ts","snippet":"1\timport { Client } from '@modelcontextprotocol/sdk/client/index.js'\n2\timport { StreamableHTTPClientTransport } from '@modelcontextprotocol/sdk/client/streamableHttp.js'\n3\timport { unwrapMcpError } from '@/lib/sql-error-messages'\n4\t\n5\tconst MCP_BASE_URL = 'https://mcp.supabase.com/mcp'\n6\t\n7\tfunction sanitizeTokens(text: string): string {\n8\t  return text.replace(/eyJ[A-Za-z0-9._-]{20,}/g, '[token]')\n9\t}\n10\t\n11\texport class SupabaseMcpClient {\n12\t  private projectRef: string\n13\t  private readOnly?: boolean\n14\t  private features?: string[]\n15\t  private client: Client | null = null\n16\t  private transport: StreamableHTTPClientTransport | null = null\n17\t  private _token: string\n18\t  private _onTokenRefresh?: () => Promise<string | null>\n19\t  private _connecting: Promise<void> | null = null\n20\t  private _connected = false\n21\t\n22\t  constructor(opts: {\n23\t    projectRef?: string\n24\t    accessToken: string\n25\t    readOnly?: boolean\n26\t    features?: string[]\n27\t    /**\n28\t     * Called on 401 to get a fresh token. Return null if refresh fails.\n29\t     * Replaces chrome.runtime.sendMessage from supa-agent's extension context.\n30\t     */\n31\t    onTokenRefresh?: () => Promise<string | null>\n32\t  }) {\n33\t    this.projectRef = opts.projectRef ?? ''\n34\t    this._token = opts.accessToken\n35\t    this.readOnly = opts.readOnly\n36\t    this.features = opts.features\n37\t    this._onTokenRefresh = opts.onTokenRefresh\n38\t  }\n39\t\n40\t  /**\n41\t   * Returns a fetch wrapper that injects the Bearer token and auto-refreshes on 401.\n42\t   */\n43\t  private _createAuthFetch(): typeof fetch {\n44\t    return async (input, init?) => {\n45\t      const url =\n46\t        typeof input === 'string'\n47\t          ? input\n48\t          : input instanceof URL\n49\t            ? input.href\n50\t            : (input as Request).url\n51\t      const headers = new Headers(init?.headers)\n52\t      headers.set('Authorization', `Bearer ${this._token}`)\n53\t\n54\t      let res = await fetch(url, { ...init, headers })\n55\t\n56\t      if (res.status === 401 && this._onTokenRefresh) {\n57\t        const newToken = await this._onTokenRefresh()\n58\t        if (newToken) {\n59\t          this._token = newToken\n60\t          headers.set('Authorization', `Bearer ${this._token}`)\n61\t          res = await fetch(url, { ...init, headers })\n62\t        }\n63\t      }\n64\t\n65\t      return res\n66\t    }\n67\t  }\n68\t\n69\t  async connect(): Promise<void> {\n70\t    if (this._connected) return\n71\t    if (this._connecting) return this._connecting\n72\t\n73\t    this._connecting = this._doConnect()\n74\t    try {\n75\t      await this._connecting\n76\t      this._connected = true\n77\t    } finally {\n78\t      this._connecting = null\n79\t    }\n80\t  }\n81\t\n82\t  private async _doConnect(): Promise<void> {\n83\t    const url = new URL(MCP_BASE_URL)\n84\t    if (this.projectRef) url.searchParams.set('project_ref', this.projectRef)\n85\t    if (this.readOnly) url.searchParams.set('read_only', 'true')\n86\t    if (this.features?.length) url.searchParams.set('features', this.features.join(','))\n87\t\n88\t    this.transport = new StreamableHTTPClientTransport(url, {\n89\t      fetch: this._createAuthFetch(),\n90\t      reconnectionOptions: {\n91\t        initialReconnectionDelay: 1000,\n92\t        maxReconnectionDelay: 30000,\n93\t        reconnectionDelayGrowFactor: 1.5,\n94\t        maxRetries: 2,\n95\t      },\n96\t    })\n97\t\n98\t    this.client = new Client({ name: 'supabasehire.me', version: '1.0.0' })\n99\t    await this.client.connect(this.transport)\n100\t  }\n101\t\n102\t  get isConnected(): boolean {\n103\t    return this._connected\n104\t  }\n105\t\n106\t  async disconnect()